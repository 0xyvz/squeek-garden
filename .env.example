# Copy to .env and fill in. Never commit .env.
# Private key of a Sepolia-only deployer wallet holding a little Sepolia ETH.
DEPLOYER_PRIVATE_KEY=
# Optional: where SQK seed payments go (defaults to the deployer).
TREASURY_ADDRESS=
# Optional: "on" opens plots 10-12 to Squeek NFT holders at launch. Off by default; the owner can switch it on
# later with setSqueekNft(<Squeek NFT address>).
SQUEEK_NFT_PERK=
# Optional: your own Sepolia RPC (defaults to publicnode).
SEPOLIA_RPC_URL=
# Optional: an Etherscan API key, to publish the contract source after deploying (the deploy prints the command).
ETHERSCAN_API_KEY=
